#!/usr/bin/env node
'use strict';
/** claude-mesh — inter-agent messaging for Claude Code sessions. */
const os = require('os');
const fs = require('fs');
const path = require('path');
const { randomBytes } = require('crypto');
const cfg = require('../src/config.js');
const { localSessions } = require('../src/discover.js');
const { deliver } = require('../src/peer.js');

function arg(a, n, d) { const i = a.indexOf(n); return i === -1 ? d : a[i + 1]; }
function has(a, n) { return a.includes(n); }

async function api(path, conf, opts = {}) {
  const res = await fetch(conf.registry + path, {
    headers: { 'Content-Type': 'application/json', ...(conf.token ? { 'X-Mesh-Token': conf.token } : {}) },
    ...opts,
  });
  const body = await res.json().catch(() => ({}));
  if (!res.ok) {
    const e = new Error(body.error || `${res.status} ${path}`);
    if (body.online) e.online = body.online;
    if (body.candidates) e.candidates = body.candidates;
    throw e;
  }
  return body;
}

/**
 * This session's mesh address, derived from its inbox socket. Sessions register
 * under their name (which follows /rename), so a pid-derived address never
 * resolves - and the recipient gets a REPLY line it cannot use.
 */
function selfAddress(conf) {
  if (conf.name) return conf.name;
  const sock = process.env.CLAUDE_CODE_MESSAGING_SOCKET || '';
  if (!sock) return '';
  try {
    const me = require('../src/discover.js').localSessions().find((x) => x.socket === sock);
    if (me?.slug) return `${conf.group}/${me.slug}`;
  } catch {}
  return '';
}

/** Print a failed address alongside who is actually reachable. */
function reportUnreachable(e) {
  console.error(`claude-mesh: ${e.message}`);
  if (e.candidates?.length) console.error(`  did you mean: ${e.candidates.join(', ')}`);
  if (e.online) {
    console.error(e.online.length ? '  online now:' : '  nothing is online right now.');
    for (const o of e.online) console.error(`    ${o}`);
  }
}


/**
 * Wait for a reply, polling in short hops. A single long request is simpler but
 * dies against reverse proxies that cap read timeouts (a 504), so we ask for a
 * bounded window repeatedly until the deadline.
 */
async function awaitReply(conf, id, totalSecs, hopSecs = 45) {
  const deadline = Date.now() + totalSecs * 1000;
  while (Date.now() < deadline) {
    const left = Math.ceil((deadline - Date.now()) / 1000);
    const hop = Math.max(5, Math.min(hopSecs, left));
    let r;
    try {
      r = await api(`/await?id=${encodeURIComponent(id)}&wait=${hop}`, conf);
    } catch (e) {
      if (!/50\d/.test(e.message)) throw e;   // proxy hiccup: keep waiting
      continue;
    }
    if (r.reply) return r.reply;
  }
  return null;
}

const HELP = `claude-mesh — LAN inter-agent messaging for Claude Code

  claude-mesh configure [--ip HOST] [--port N] [--token T] [--group G] [--name N]
                                 write ~/.claude-mesh/config.json and install the
                                 SessionStart/SessionEnd hooks into Claude Code
      --gen-token                generate a fresh 32-byte token
      --no-hooks                 config only, don't touch settings.json
      --accept-inbound           set crossSessionInbound=accept, so peer messages
                                 reach idle sessions without waiting for approval
      --uninstall                remove the mesh hooks again

  claude-mesh serve [--port N] [--bind ADDR]     run the registry (on your server)
  claude-mesh relay                              run this machine's relay daemon
  claude-mesh service                            install + start the relay service
  claude-mesh update [--main] [--ref TAG]        pull the latest release, refresh
                                                 hooks/skill/service, keep config
                                                 ('upgrade' is the same command)
  claude-mesh peers [--group G]                  who is online (all groups by default)
  claude-mesh local                              live sessions on this machine
  claude-mesh send --to [GROUP/]NAME --body TEXT [--group G] [--intent ...] [--re ID] [--now]
       --now                     ask the receiver to surface it immediately
       --wait [SECS]             block until the recipient replies (default 120)

  claude-mesh ask --to [GROUP/]NAME --body QUESTION [--wait SECS]
                                 send a question and print the answer (blocks)
                                 address across groups: --to macmini/mobileApp
  claude-mesh status                             show resolved config
  claude-mesh token                              print the shared token
  claude-mesh user list|add|passwd|remove        dashboard accounts (on the registry host)
  claude-mesh invite [--ttl SECS] [--uses N]     mint a single-use join code
  claude-mesh join --code CODE [--ip URL]        redeem one on a new machine

Config precedence: env (MESH_*) > ~/.claude-mesh/config.json > defaults.`;

async function main() {
  let [cmd, ...rest] = process.argv.slice(2);
  // 'upgrade' shipped first and only refreshed hooks, reporting success while
  // leaving the machine on old code - which is how a machine gets stranded
  // without whatever command would have fixed it. Same command now.
  if (cmd === 'upgrade') cmd = 'update';
  const conf = cfg.load();

  if (!cmd || cmd === '--help' || cmd === '-h' || cmd === 'help' || has(rest, '--help'))
    return console.log(HELP);

  if (cmd === 'configure') {
    if (has(rest, '--uninstall')) {
      const r = require('../src/install.js').uninstall();
      return console.log(`removed ${r.removed} mesh hook(s) from ${r.settingsPath}`);
    }
    const ip   = arg(rest, '--ip');
    const port = arg(rest, '--port');
    const token = has(rest, '--gen-token') ? randomBytes(32).toString('hex') : arg(rest, '--token');
    const patch = {};
    if (ip) {
      if (/^https?:\/\//.test(ip)) {
        patch.registry = ip.replace(/\/+$/, '');
        if (port) console.warn(`note: --port ${port} ignored; --ip is a full URL`);
      } else {
        patch.registry = `http://${ip}:${port || 8787}`;
      }
    }
    if (token) patch.token = token;
    const g = arg(rest, '--group'); if (g) patch.group = g;
    const n = arg(rest, '--name');  if (n) patch.name = n;
    const rid = arg(rest, '--relay-id'); if (rid) patch.relayId = rid;

    cfg.save(patch);
    const saved = cfg.load();          // show resolved values, not just the patch
    console.log(`config  ${cfg.FILE}`);
    console.log(`registry ${saved.registry}`);
    console.log(`token    ${saved.token ? saved.token.slice(0, 8) + '… (' + saved.token.length + ' chars)' : 'NONE — registry will refuse to start'}`);
    if (has(rest, '--gen-token')) console.log(`\nFULL TOKEN (use on every machine + the server):\n  ${saved.token}\n`);

    if (!saved.token) {
      console.error('\nWARNING: no token set. Every request will be refused (401).');
      console.error('Set the shared token from your registry:');
      console.error('  claude-mesh configure --token <token>\n');
    }

    const instMod = require('../src/install.js');
    const sk = instMod.installSkill();
    for (const d of sk.installed) console.log(`skill  -> ${d}`);
    const ch = instMod.installCodexHooks();
    if (ch.file) {
      console.log(`codex  -> ${ch.file} (${ch.events.join(', ')})`);
      console.log(`          ${ch.note}`);
    }

    if (!has(rest, '--no-hooks')) {
      const r = require('../src/install.js').install({ acceptInbound: has(rest, '--accept-inbound') });
      console.log(`hooks installed into ${r.settingsPath} (backup: .mesh-backup)`);
      console.log(`crossSessionInbound: ${r.crossSessionInbound}`);
      if (r.crossSessionInbound !== 'accept')
        console.log('  tip: re-run with --accept-inbound so mesh messages are delivered\n' +
                    '       straight into idle sessions instead of waiting for approval');
      console.log('New sessions will register automatically; existing ones on next start.');
    }
    return;
  }

  if (cmd === 'service') {
    const r = require('../src/install.js').applyService();
    console.log(`wrote ${r.file}`);
    console.log(r.ok ? 'service installed and started.'
                     : 'service file written, but starting it failed; run manually:\n  ' +
                       (r.reload || []).join('\n  '));
    if (r.platform === 'linux')
      console.log('to survive logout:  sudo loginctl enable-linger $USER');
    return;
  }

  if (cmd === 'update') {
    const { execSync } = require('child_process');
    const appDir = path.resolve(__dirname, '..');

    // No git checkout (an older layout, or npm): hand it to the installer,
    // which is fetched fresh every time and knows how to migrate what is there.
    if (!fs.existsSync(path.join(appDir, '.git'))) {
      console.log('no git checkout here - running the installer (config is kept)');
      const flag = has(rest, '--main') ? ' -s -- --main' : '';
      try {
        execSync('curl -fsSL https://raw.githubusercontent.com/Monitor-My-Solar/claude-mesh/main/install.sh | bash' + flag,
                 { stdio: 'inherit' });
      } catch {
        console.error('claude-mesh: the installer failed; run it by hand:');
        console.error('  curl -fsSL https://raw.githubusercontent.com/Monitor-My-Solar/claude-mesh/main/install.sh | bash');
        process.exit(1);
      }
      return;
    }

    const describe = () => {
      try { return execSync('git describe --tags --always', { cwd: appDir }).toString().trim(); }
      catch { return '?'; }
    };
    const before = describe();
    try {
      execSync('git fetch --quiet --tags --force origin main', { cwd: appDir, stdio: 'ignore' });
      let target = arg(rest, '--ref', '');
      if (!target) {
        if (has(rest, '--main') || process.env.MESH_CHANNEL === 'main') target = 'origin/main';
        else {
          const tags = execSync("git tag -l 'v*' --sort=-v:refname", { cwd: appDir })
            .toString().trim().split('\n').filter(Boolean);
          target = tags[0] || 'origin/main';
        }
      }
      execSync(`git reset --quiet --hard ${target}`, { cwd: appDir, stdio: 'ignore' });
    } catch {
      console.error('claude-mesh: could not fetch updates (no network, or local changes).');
      process.exit(1);
    }
    const after = describe();
    console.log(before === after ? `already up to date (${after})` : `updated ${before} -> ${after}`);

    const inst = require('../src/install.js');
    inst.installSkill();
    inst.install();
    inst.installCodexHooks();
    const sv = inst.applyService();
    console.log(`refreshed hooks, skill and service${sv.ok ? ' (relay restarted)' : ''}`);
    console.log(`config kept: ${conf.registry}`);
    return;
  }

  if (cmd === 'user' || cmd === 'users') {
    // Account management runs ON the registry host, against its user store.
    const users = require('../src/users.js');
    const [sub, ...a] = rest;

    if (!sub || sub === 'list') {
      const list = users.list();
      if (!list.length) return console.log('no accounts yet - the first sign-in creates the admin');
      for (const u of list) console.log(`${u.username.padEnd(20)} ${u.role}`);
      return;
    }
    if (sub === 'add') {
      const name = a[0];
      const pw = arg(a, '--password');
      if (!name || !pw) { console.error('usage: claude-mesh user add <username> --password <pw> [--role admin|viewer]'); process.exit(1); }
      try { console.log('created', users.create(name, pw, { role: arg(a, '--role', 'viewer') })); }
      catch (e) { console.error(`claude-mesh: ${e.message}`); process.exit(1); }
      return;
    }
    if (sub === 'passwd') {
      const name = a[0], pw = arg(a, '--password');
      if (!name || !pw) { console.error('usage: claude-mesh user passwd <username> --password <pw>'); process.exit(1); }
      try { users.setPassword(name, pw); console.log('password updated'); }
      catch (e) { console.error(`claude-mesh: ${e.message}`); process.exit(1); }
      return;
    }
    if (sub === 'remove' || sub === 'rm') {
      const n = users.remove(a[0]);
      return console.log(n ? `removed ${a[0]}` : `no such user '${a[0]}'`);
    }
    console.error(`unknown: user ${sub}`); process.exit(1);
  }

  if (cmd === 'token') {
    // Retrieving the shared token after the fact. Prints nothing else, so it
    // composes: claude-mesh token | pbcopy
    if (!conf.token) { console.error('no token configured'); process.exit(1); }
    console.log(conf.token);
    return;
  }

  if (cmd === 'invite') {
    // Mint a short-lived single-use join code, so adding a machine never means
    // pasting the master token into a terminal, a chat, or a transcript.
    const ttl = Number(arg(rest, '--ttl', '900'));
    const uses = Number(arg(rest, '--uses', '1'));
    const j = await api('/join/new', conf, {
      method: 'POST', body: JSON.stringify({ ttl, uses }),
    });
    const mins = Math.round(j.expires_in / 60);
    console.log(`\n  Join code: ${j.code}`);
    console.log(`  Valid for ${mins} minute(s), ${j.uses} use(s).\n`);
    console.log('  On the new machine, run:\n');
    console.log('    curl -fsSL https://raw.githubusercontent.com/Monitor-My-Solar/claude-mesh/main/install.sh \\');
    console.log(`      | bash -s -- --registry ${conf.registry} --join ${j.code}\n`);
    return;
  }

  if (cmd === 'join') {
    // Redeem a join code for the shared token and configure this machine.
    const code = arg(rest, '--code', rest[0]);
    const registry = arg(rest, '--ip', conf.registry);
    if (!code) { console.error('usage: claude-mesh join --code <CODE> [--ip <registry>]'); process.exit(1); }
    const res = await fetch(`${registry}/join/redeem`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ code }),
    });
    const body = await res.json().catch(() => ({}));
    if (!res.ok) { console.error(`claude-mesh: ${body.error || res.status}`); process.exit(1); }
    cfg.save({ registry, token: body.token });
    console.log(`joined ${registry}`);
    return;
  }

  if (cmd === 'status') {
    console.log(`registry ${conf.registry}`);
    console.log(`token    ${conf.token ? conf.token.slice(0, 8) + '…' : '(none)'}`);
    console.log(`relayId  ${conf.relayId}`);
    console.log(`group    ${conf.group}`);

    let reachable = false;
    try {
      const h = await api('/health', conf);
      console.log(`server   reachable, ${h.peers} peer(s)`);
      reachable = true;
    } catch (e) {
      console.log(`server   UNREACHABLE (${e.message})`);
    }

    // Whether THIS machine's relay is running is the most common failure:
    // without it the machine is invisible and nothing says why.
    const { localSessions } = require('../src/discover.js');
    const local = localSessions();
    console.log(`sessions ${local.length} live on this machine`);

    if (reachable) {
      let mine = [];
      try {
        const { routes } = await api(`/routes?relay=${encodeURIComponent(conf.relayId)}`, conf);
        mine = routes;
      } catch {}
      const registered = new Set(mine.map((r) => r.name));
      const missing = local.filter((s) => !registered.has(s.slug));
      if (!local.length) {
        console.log('relay    (no local sessions to register)');
      } else if (!missing.length) {
        console.log(`relay    running - all ${local.length} session(s) registered`);
      } else if (missing.length < local.length) {
        // Some registered: the relay is alive but mid-cycle, or those sessions
        // started since its last pass. It re-registers every 15s.
        console.log(`relay    running - ${local.length - missing.length} of ${local.length} ` +
                    'session(s) registered, the rest catch up within ~15s');
      } else {
        console.log(`relay    NOT RUNNING - none of this machine's ${local.length} session(s) ` +
                    'are registered,');
        console.log('         so it cannot be reached. Start it with:');
        console.log('           claude-mesh service        (installs + starts it)');
        console.log('           claude-mesh relay          (foreground, to debug)');
      }
    }
    return;
  }

  if (cmd === 'serve') {
    process.env.MESH_TOKEN = conf.token;
    if (arg(rest, '--port')) process.env.MESH_PORT = arg(rest, '--port');
    if (arg(rest, '--bind')) process.env.MESH_BIND = arg(rest, '--bind');
    const { createRegistry } = require('../src/registry.js');
    const port = Number(process.env.MESH_PORT || 8787);
    const host = process.env.MESH_BIND || '0.0.0.0';
    return createRegistry().listen(port, host,
      () => console.log(`claude-mesh registry ${host}:${port} (auth on)`));
  }

  if (cmd === 'relay') {
    process.env.MESH_REGISTRY = conf.registry;
    process.env.MESH_TOKEN = conf.token;
    process.env.MESH_RELAY_ID = conf.relayId;
    process.env.MESH_GROUP = conf.group;
    return require('../src/relay.js').main();
  }

  if (cmd === 'local') {
    for (const s of localSessions())
      console.log(`${conf.relayId}/${s.pid}\t${s.socket}${s.self ? '\t(this session)' : ''}`);
    return;
  }

  if (cmd === 'peers') {
    const g = arg(rest, '--group');          // no filter unless asked
    const { peers } = await api(`/peers${g ? `?group=${encodeURIComponent(g)}` : ''}`, conf);
    if (!peers.length) return console.log(g ? `(no peers in group '${g}')` : '(no peers online)');
    const byGroup = new Map();
    for (const p of peers) {
      if (!byGroup.has(p.group)) byGroup.set(p.group, []);
      byGroup.get(p.group).push(p);
    }
    for (const [group, list] of [...byGroup].sort()) {
      console.log(`\n${group}`);
      // Deliberately named sessions first, then most recently seen: an agent
      // scanning this should meet the addressable ones at the top.
      list.sort((a, b) => (b.named - a.named) || (b.seen - a.seen));
      for (const p of list) {
        const age = Math.round((Date.now() - p.seen) / 1000);
        const st = p.status ? p.status.padEnd(5) : '     ';
        const tag = p.named ? ' *' : '  ';
        const kind = (p.kind || 'claude').padEnd(6);
        console.log(`  ${p.name.padEnd(30)}${tag}${kind} ${st}  ${(p.cwd || '-').padEnd(30)} ${age}s ago`);
      }
    }
    const named = peers.find((p) => p.named) || peers[0];
    console.log(`\n* = deliberately named (via /rename); others are directory-derived.`);
    console.log(`Address a peer as group/name, e.g.`);
    console.log(`  claude-mesh send --to ${named.group}/${named.name} --body "..."`);
    console.log(`  claude-mesh ask  --to ${named.group}/${named.name} --body "<question>"`);
    return;
  }

  if (cmd === 'send') {
    const to = arg(rest, '--to'), body = arg(rest, '--body');
    // Default --from to THIS session's registered name, derived from the inbox
    // socket, so a reply address is always resolvable. Guessing a label (or
    // using a stale pid from an earlier session) yields an unaddressable REPLY.
    const selfName = selfAddress(conf);
    if (!to || !body) { console.error('usage: claude-mesh send --to NAME --body TEXT'); process.exit(1); }
    let j;
    try {
      j = await api('/send', conf, {
      method: 'POST',
      body: JSON.stringify({
        to, body,
        from:    arg(rest, '--from', selfName || `${conf.group}/cli`),
        intent:  arg(rest, '--intent', 'inform'),
        re:      arg(rest, '--re', ''),
        group:   conf.group,                    // sender's group
        toGroup: arg(rest, '--group', ''),      // optional recipient group
        priority: has(rest, '--now') ? 'immediate' : 'next',
      }),
      });
    } catch (e) {
      reportUnreachable(e);
      process.exit(1);
    }
    if (!has(rest, '--wait')) return console.log(`queued ${j.id} -> ${to}`);

    // Block until the recipient replies with --re <this id>.
    const secs = Number(arg(rest, '--wait', '120'));
    process.stderr.write(`queued ${j.id} -> ${to}; waiting up to ${secs}s for a reply...\n`);
    const got = await awaitReply(conf, j.id, secs);
    if (!got) {
      console.error(`no reply within ${secs}s (the message was delivered; the agent may be busy)`);
      process.exit(2);
    }
    console.log(got.body);
    return;
  }

  if (cmd === 'ask') {
    // Send a question and block for the answer: the RPC form of send.
    const to = arg(rest, '--to'), body = arg(rest, '--body');
    if (!to || !body) { console.error('usage: claude-mesh ask --to NAME --body TEXT [--wait SECS]'); process.exit(1); }
    const secs = Number(arg(rest, '--wait', '120'));
    const selfName = selfAddress(conf);

    let j;
    try {
      j = await api('/send', conf, {
        method: 'POST',
        body: JSON.stringify({
          to, body, from: selfName || 'unknown', intent: 'reply-needed',
          group: conf.group, toGroup: arg(rest, '--group', ''),
          priority: 'immediate',
        }),
      });
    } catch (e) {
      reportUnreachable(e);
      process.exit(1);
    }
    process.stderr.write(`asked ${to} (${j.id}); waiting up to ${secs}s...\n`);
    const got = await awaitReply(conf, j.id, secs);
    if (!got) {
      console.error(`no reply within ${secs}s`);
      process.exit(2);
    }
    console.log(got.body);
    return;
  }

  console.error(`unknown command '${cmd}'\n`); console.log(HELP); process.exit(1);
}

main().catch((e) => { console.error('claude-mesh:', e.message); process.exit(1); });
