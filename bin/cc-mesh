#!/usr/bin/env node
'use strict';
/** cc-mesh — CLI for the claude-mesh inter-agent message bus. */
const os = require('os');
const { localSessions } = require('../src/discover.js');
const { deliver } = require('../src/peer.js');

const REGISTRY = process.env.MESH_REGISTRY || 'http://127.0.0.1:8787';
const TOKEN    = process.env.MESH_TOKEN || '';
const RELAY_ID = process.env.MESH_RELAY_ID || os.hostname();

const headers = () => ({
  'Content-Type': 'application/json',
  ...(TOKEN ? { 'X-Mesh-Token': TOKEN } : {}),
});

function arg(argv, name, def) {
  const i = argv.indexOf(name);
  return i === -1 ? def : argv[i + 1];
}

async function main() {
  const [cmd, ...rest] = process.argv.slice(2);

  if (cmd === 'local') {
    for (const s of localSessions())
      console.log(`${RELAY_ID}/${s.pid}\t${s.socket}${s.self ? '\t(this session)' : ''}`);
    return;
  }

  if (cmd === 'peers') {
    const g = arg(rest, '--group');
    const r = await fetch(`${REGISTRY}/peers${g ? `?group=${encodeURIComponent(g)}` : ''}`, { headers: headers() });
    const { peers } = await r.json();
    for (const p of peers) console.log(`${p.name}\t${p.group}\t${p.host}\t${p.cwd || '-'}`);
    return;
  }

  if (cmd === 'send') {
    const to = arg(rest, '--to'), body = arg(rest, '--body');
    if (!to || !body) { console.error('usage: cc-mesh send --to <name> --body <text>'); process.exit(1); }
    const r = await fetch(`${REGISTRY}/send`, {
      method: 'POST', headers: headers(),
      body: JSON.stringify({
        to, body,
        from:   arg(rest, '--from', process.env.MESH_NAME || `${RELAY_ID}/${process.pid}`),
        intent: arg(rest, '--intent', 'inform'),
        re:     arg(rest, '--re', ''),
        group:  arg(rest, '--group', process.env.MESH_GROUP || 'default'),
      }),
    });
    const j = await r.json();
    if (!r.ok) { console.error('cc-mesh:', j.error); process.exit(1); }
    console.log(`queued ${j.id} -> ${to}`);
    return;
  }

  if (cmd === 'tell') {
    const sock = arg(rest, '--socket'), body = arg(rest, '--body');
    if (!sock || !body) { console.error('usage: cc-mesh tell --socket <path> --body <text>'); process.exit(1); }
    await deliver({
      socketPath: sock,
      token: process.env.CLAUDE_CODE_MESSAGING_TOKEN,
      body,
      fromName: arg(rest, '--name', 'cc-mesh'),
    });
    console.log(`delivered -> ${sock}`);
    return;
  }

  console.log(`cc-mesh — inter-agent messaging for Claude Code

  cc-mesh local                     list live sessions on this machine
  cc-mesh peers [--group G]         list registered peers across the mesh
  cc-mesh send --to N --body T      queue a message via the registry
       [--intent request|inform|reply-needed|fyi] [--re ID] [--from N]
  cc-mesh tell --socket S --body T  deliver straight to a local socket

Env: MESH_REGISTRY (${REGISTRY})  MESH_TOKEN  MESH_RELAY_ID (${RELAY_ID})  MESH_GROUP`);
}

main().catch((e) => { console.error('cc-mesh:', e.message); process.exit(1); });
